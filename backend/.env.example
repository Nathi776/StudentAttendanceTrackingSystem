# Copy this file to .env and update values for your environment.

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=wonderful-generosity-production.up.railway.app,.railway.app
DJANGO_SETTINGS_MODULE=myserver.settings_production

# Database (use the external URL from Render)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Email (optional)
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=you@example.com
#EMAIL_HOST_PASSWORD=your-app-password

# CORS (include your frontend URL)
CORS_ALLOWED_ORIGINS=https://student-attendance-tracking-system-zeta.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://student-attendance-tracking-system-zeta.vercel.app,http://localhost:3000

# Optional production security overrides
#DJANGO_SECURE_SSL_REDIRECT=True
#DJANGO_SECURE_HSTS_SECONDS=31536000
#DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#DJANGO_SECURE_HSTS_PRELOAD=True
